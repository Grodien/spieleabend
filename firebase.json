{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Spieleabend",
        "supportEmail": "thomas.bomatter@gmail.com",
        "authorizedRedirectUris": [
          "https://spieleabend-tracker.web.app",
          "http://localhost"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "spieleabend-db"
  },
  "hosting": {
    "public": "dist/spieleabend/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
